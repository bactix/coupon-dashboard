# Base URL of the backend API.
# - Local dev: http://localhost:4000
# - Railway:   the backend service's PUBLIC domain (browser calls it directly,
#              so it CANNOT be the internal *.railway.internal host).
# NOTE: NEXT_PUBLIC_* vars are baked in at build time — set before deploying
#       and redeploy if you change it. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000
